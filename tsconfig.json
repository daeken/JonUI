{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "lib": [
      "ES2022",
      "DOM"
    ],
    "paths": {
      "jonui": [
        "./api/index.d.ts"
      ]
    },
    "allowImportingTsExtensions": true,
    "types": [
      "node"
    ]
  },
  "include": [
    "api/**/*.ts",
    "examples/**/*.ts",
    "tests/**/*.ts"
  ]
}
